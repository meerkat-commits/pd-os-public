<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.pd-os.weekly</string>

    <key>ProgramArguments</key>
    <array>
      <string>@REPO_ROOT@/setup/bin/run-weekly.sh</string>
    </array>

    <!-- Mondays at 07:30 local time (Weekday 1 = Monday in launchd) -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/pd-os.weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pd-os.weekly.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
