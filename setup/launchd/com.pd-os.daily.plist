<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.pd-os.daily</string>

    <key>ProgramArguments</key>
    <array>
      <string>@REPO_ROOT@/setup/bin/run-daily.sh</string>
    </array>

    <!-- Every day at 16:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/pd-os.daily.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pd-os.daily.log</string>

    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
