# PD-OS secrets (copy to ~/.config/pd-os/env)
#
#   mkdir -p ~/.config/pd-os
#   cp setup/config/env.example ~/.config/pd-os/env
#   chmod 600 ~/.config/pd-os/env
#
# Granola Personal API key (starts with grn_). Not the MCP/OAuth token.

export GRANOLA_API_KEY='grn_REPLACE_ME'

# Performance review calibration reminders (optional)
# export CALIBRATION_CALL_DATE='2026-06-05'
