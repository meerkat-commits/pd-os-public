{
  "project": "2026-06-nova-nightly-screenshots",
  "firefox_binary": "/Applications/Firefox Nightly.app",
  "firefox_app": "Firefox Nightly",
  "window": {
    "width": 1440,
    "height": 900
  },
  "base_prefs": {
    "browser.nova.enabled": true,
    "browser.newtabpage.enabled": true,
    "browser.newtabpage.activity-stream.nova.enabled": true,
    "browser.urlbar.quicksuggest.ampTopPickUseNovaIconSize": true,
    "browser.smartwindow.enabled": true
  },
  "shots": [
    {
      "id": "chrome",
      "filename": "01-chrome.png",
      "profile": "nova",
      "url": "https://example.com",
      "wait_ms": 8000,
      "notes": "Default Nova chrome on a loaded page (no-marionette to avoid urlbar stripes).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "sidebar",
      "filename": "02-sidebar.png",
      "profile": "nova",
      "url": "https://example.com",
      "prefs": {
        "sidebar.revamp": true,
        "sidebar.visibility": "always-show",
        "sidebar.backupState": "{\"command\":\"viewBookmarksSidebar\",\"panelWidth\":291,\"launcherWidth\":56,\"expandedLauncherWidth\":217,\"launcherExpanded\":false,\"launcherVisible\":true}"
      },
      "wait_ms": 8000,
      "notes": "Bookmarks sidebar open via sidebar.backupState pref (no-marionette: avoids urlbar stripes).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "vertical-tabs",
      "filename": "03-vertical-tabs.png",
      "profile": "nova",
      "url": "https://example.com",
      "prefs": {
        "sidebar.verticalTabs": true,
        "sidebar.revamp": true,
        "sidebar.visibility": "always-show",
        "browser.pinning.onboarding.dismissed": true,
        "browser.tabs.pinnedTabsOnboarding.dismissed": true,
        "sidebar.new-sidebar.has-used": true
      },
      "wait_ms": 8000,
      "notes": "Vertical tabs via sidebar.verticalTabs pref (no-marionette: avoids urlbar stripes; pinning onboarding dismissed).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "tab-grouping",
      "filename": "04-tab-grouping.png",
      "profile": "nova",
      "url": "https://example.com",
      "prefs": {
        "browser.tabs.groups.enabled": true
      },
      "open_tabs": [
        "https://example.com",
        "https://www.mozilla.org",
        "https://www.example.org"
      ],
      "tab_group": true,
      "wait_ms": 3500,
      "notes": "Three tabs; best-effort tab group via chrome script.",
      "automation": "best_effort"
    },
    {
      "id": "new-tab",
      "filename": "05-new-tab.png",
      "profile": "nova",
      "url": "about:newtab",
      "prefs": {
        "sidebar.revamp": true,
        "sidebar.visibility": "always-show"
      },
      "wait_ms": 12000,
      "notes": "Nova new tab page (no-marionette: Activity Stream is suppressed under Marionette).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "private-window",
      "filename": "06-private-window.png",
      "profile": "nova",
      "url": "about:privatebrowsing",
      "firefox_args": [
        "-private-window"
      ],
      "wait_ms": 8000,
      "notes": "Private browsing window (no-marionette to avoid urlbar stripes).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "smart-window",
      "filename": "07-smart-window.png",
      "profile": "nova",
      "url": "about:newtab",
      "prefs": {
        "browser.smartwindow.tos.consentTime": 1
      },
      "wait_ms": 12000,
      "notes": "Smart Window requires Mozilla account sign-in — no programmatic launch path exists. Capture manually via hamburger menu → New Smart Window after signing in.",
      "automation": "manual"
    },
    {
      "id": "search",
      "filename": "08-search.png",
      "profile": "nova",
      "url": "about:blank",
      "keys": [
        "Meta+l"
      ],
      "type_text": "firefox nova",
      "wait_ms": 3000,
      "notes": "Urlbar focused with query text.",
      "automation": "automated"
    },
    {
      "id": "first-run",
      "filename": "09-first-run.png",
      "profile": "first-run",
      "url": "about:home",
      "firefox_args": [
        "-new-instance"
      ],
      "wait_ms": 8000,
      "notes": "Fresh profile \u2014 About Welcome / first-run onboarding.",
      "automation": "automated"
    },
    {
      "id": "continuous",
      "filename": "10-continuous.png",
      "profile": "continuous",
      "url": "https://example.com",
      "firefox_args": [
        "-new-instance"
      ],
      "wait_ms": 5000,
      "notes": "Post-first-run profile for deferred / continuous onboarding prompts.",
      "automation": "automated"
    },
    {
      "id": "settings-account",
      "filename": "11-settings-account.png",
      "profile": "nova",
      "url": "about:preferences#sync",
      "wait_ms": 8000,
      "notes": "Settings \u2014 Account section selected (no-marionette to avoid urlbar stripes).",
      "automation": "hybrid",
      "requires_no_marionette": true
    },
    {
      "id": "customize-toolbar",
      "filename": "12-customize-toolbar.png",
      "profile": "nova",
      "url": "https://example.com",
      "customize_toolbar": true,
      "wait_ms": 8000,
      "notes": "Customize Toolbar mode (foxfooding: empty space layout).",
      "automation": "automated"
    },
    {
      "id": "chrome-dark",
