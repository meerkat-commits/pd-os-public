      "notes": "Vertical tabs scrolled \u2014 overflow fade and div line (foxfooding TC-VT-01/02). Uses about:blank tabs to avoid DNS dependency.",
      "automation": "automated"
    },
    {
      "id": "tab-grouping-collapsed",
      "filename": "16-tab-grouping-collapsed.png",
      "profile": "nova",
      "url": "https://example.com",
      "prefs": {
        "browser.tabs.groups.enabled": true
      },
      "open_tabs": [
        "https://example.com",
        "https://www.mozilla.org",
